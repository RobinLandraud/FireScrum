{
  "enabledMcpjsonServers": ["github", "playwright", "angular-cli", "spartan-ui", "context7"],
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(npm run check-build:*)",
      "Bash(npm run lint:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(cat .env*)"
    ]
  }
}
