{
  "permissions": {
    "allow": [
      "Bash(xargs -I{} sh -c 'echo ===={}====; cat {}')",
      "Bash(xargs -I{} sh -c 'echo ==={}===; cat {}')",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(npm run check-build:*)",
      "Bash(npm run lint:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat .env*)"
    ]
  }
}
