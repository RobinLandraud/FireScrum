{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(just dev)",
      "Bash(just prod)",
      "Bash(just down)",
      "Bash(just tests *)",
      "Bash(just e2e *)",
      "Bash(npm run start *)",
      "Bash(npm run build *)",
      "Bash(npm run lint *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(scripts/gen-contracts.sh *)",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__context7",
      "mcp__angular-cli",
      "mcp__spartan-ui",
      "mcp__playwright",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__get_label",
      "mcp__github__list_issue_fields",
      "mcp__github__list_issue_types"
    ],
    "ask": [ "mcp__github__issue_write" ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)",
      "Edit(./**/package.json)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.mcp.json)",
      "Read(./.config/**)",
      "Bash(cat .config*)",
      "Bash(ls .config*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow.sh" }
        ]
      }
    ]
  }
}
