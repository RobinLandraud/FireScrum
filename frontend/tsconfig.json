{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@contracts/*": ["../contracts/*"],
      "@spartan-ng/helm/button": ["./libs/ui/button/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/ui/utils/index.ts"],
      "@spartan-ng/helm/input": ["./libs/ui/input/index.ts"],
      "@spartan-ng/helm/textarea": ["./libs/ui/textarea/index.ts"],
      "@spartan-ng/helm/label": ["./libs/ui/label/index.ts"],
      "@spartan-ng/helm/checkbox": ["./libs/ui/checkbox/index.ts"],
      "@spartan-ng/helm/badge": ["./libs/ui/badge/index.ts"],
      "@spartan-ng/helm/card": ["./libs/ui/card/index.ts"],
      "@spartan-ng/helm/sonner": ["./libs/ui/sonner/index.ts"],
      "@spartan-ng/helm/dialog": ["./libs/ui/dialog/index.ts"],
      "@spartan-ng/helm/progress": ["./libs/ui/progress/index.ts"],
      "@spartan-ng/helm/tabs": ["./libs/ui/tabs/index.ts"]
    }
  },
  "files": ["src/main.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
