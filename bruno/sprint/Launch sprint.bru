meta {
  name: Launch sprint
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/sprints
  body: json
  auth: none
}

body:json {
  {
    "name": "Sprint 1",
    "user_story_ids": [{{userStoryId}}]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("sprintId", res.body.id);
}

docs {
  Les US doivent être validées et non terminées.
  Les US reportées des sprints précédents sont ajoutées automatiquement.
  409 si un sprint est déjà en cours.
}
