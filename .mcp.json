{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "angular-cli": {
      "command": "npx",
      "args": [
        "-y",
        "@angular/cli@22",
        "mcp"
      ]
    },
    "spartan-ui": {
      "command": "npx",
      "args": [
        "-y",
        "@spartan-ng/mcp@1.9"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--browser",
        "chromium"
      ]
    }
  }
}
