meta {
  name: Update user story
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/user-stories/{{userStoryId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "En tant que PO, je modifie une US",
    "description": "Titre, description, vélocité et feature",
    "velocity": 5,
    "feature_id": {{featureId}}
  }
}

assert {
  res.status: eq 204
}
