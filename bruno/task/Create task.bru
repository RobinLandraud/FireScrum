meta {
  name: Create task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user-stories/{{userStoryId}}/tasks
  body: json
  auth: none
}

body:json {
  {
    "title": "Formulaire de création de feature",
    "description": "Modal avec titre et description",
    "validation_points": ["Le titre est obligatoire", "La feature apparaît dans le backlog"]
  }
}

assert {
  res.status: eq 201
  res.body.status: eq todo
}

script:post-response {
  bru.setVar("taskId", res.body.id);
  bru.setVar("validationPointId", res.body.validation_points[0].id);
}
